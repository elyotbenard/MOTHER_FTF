<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Carte des Festivals de Tatouage</title>
  
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  
  <style>
    body { margin: 0; padding: 0; background-color: #1169c2; }
    #map { width: 100vw; height: 100vh; }
  </style>
</head>
<body>

  <div id="map"></div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    const map = L.map('map').setView([46.603354, 1.888334], 5);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=cb1_3q57_1_2ae0965728892381462e5f84', {
      maxZoom: 15,
      minZoom: 6,
      subdomains: 'abcd',
      attribution: '© OpenStreetMap © CARTO'
    }).addTo(map);

    fetch('festivals.json')
      .then(res => res.json())
      .then(data => {
        data.forEach(festival => {
          const lat = parseFloat(festival.lat);
          const lng = parseFloat(festival.lng);

          if (!isNaN(lat) && !isNaN(lng)) {
            let popup = `<b>${festival.nom || 'Festival'}</b>`;
            if (festival.ville) popup += `<br>${festival.ville}`;
            if (festival.date) popup += `<br><i>${festival.date}</i>`;

            L.marker([lat, lng])
              .addTo(map)
              .bindPopup(popup);
          }
        });
      })
      .catch(err => console.error("Erreur de chargement :", err));
  </script>

</body>
</html>
